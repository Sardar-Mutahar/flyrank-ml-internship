(f'Leaky model - Precision@50: {prec_at_50_leaky:.4f}')\nprint()\n\n# --- Step C: Show the suspicious result ---\nprint('=== Suspicious Result Explanation ===')\nprint(f'With the label-derived feature (leaked_trend_direction), the model')\nprint(f'can essentially read the answer. AP={ap_leaky:.4f} is unrealistically high')\nprint(f'because the feature directly encodes the target (is_declining_label =').\nprint(f'trend_direction == \"down\"). This is label leakage Ã¢â‚¬" the model appears')\nprint(f'excellent because it has been given information derived from the answer.)')\nprint()\n\n# --- Step D: Remove the leaked feature ---\nprint('=== Honest Model (without leaked feature) ===')\nfeature_df_honest = df[['content_id'] + feature_names].copy()\nfeature_df_honest['is_declining_label'] = (df['trend_direction'] == 'down').astype(int)\n\nX_honest = feature_df_honest[feature_names]\nlr_honest = LogisticRegression(max_iter=1000)\nX_train, X_test, y_train, y_test = train_test_split(X_honest, y, test_size=0.2, random_state=42, stratify=y)\nlr_honest.fit(X_train, y_train)\nprobs_honest = lr_honest.predict_proba(X_test)[:, 1]\nap_honest = average_precision_score(y_test, probs_honest)\nprec_at_20_honest = precision_at_k(y_test.values, probs_honest, 20)\nprec_at_50_honest = precision_at_k(y_test.values, probs_honest, 50)\n\nprint(f'Honest model - Average Precision (AP): {ap_honest:.4f}')\nprint(f'Honest model - Precision@20: {prec_at_20_honest:.4f}')\nprint(f'Honest model - Precision@50: {prec_at_50_honest:.4f}')\nprint()\nprint('=== Final Feature Set ===')\nprint(f'Features in honest feature frame: {list(feature_df_honest.columns)}')\nprint(f'Leaked feature "leaked_trend_direction" is NOT in the honest feature frame')\nprint(f'The leaked feature was removed and must not be used in the real modeling pipeline.')\n\n# Display final honest feature dataframe\nprint('\\n=== Honest Feature DataFrame (first 5 rows) ===')\nprint(feature_df_honest.head(5).to_string())\nprint(f'\\nHones