   "metadata": {},
   "source": "## 5. Why ML beats a fixed rule here\n\n*What makes the pattern too messy for an if-statement?*"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Section 5: Compare fixed rule vs ML\n",
    "# Fixed rule example: \"If trend_direction == 'down', prioritize the page.\"\n",
    "# We analyze the limitations of this rule using the actual data.\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "df = pd.read_csv('data/raw/content_refresh_anonymized.csv')\n",
    "\n",
    "# Apply the fixed rule\n    "fixed_declining = df[df['trend_direction'] == 'down']\n    "print(f'Fixed rule captures: {len(fixed_declining)} rows ({len(fixed_declining)/len(df)*100:.1f}%)')\n",
    "\n",
    "# Limitation 1: Treats all declining pages equally regardless of volume\n    "high_impact = fixed_declining[fixed_declining['impressions_90d'] >= 500]\n    "low_impact = fixed_declining[fixed_declining['impressions_90d'] < 100]\n    "print(f'Declining pages with >= 500 impressions: {len(high_impact)}')\n    "print(f'Declining pages with < 100 impressions: {len(low_impact)}')\n",
    "\n",
    "# Limitation 2: Ignores CTR differences among declining pages\n    "declining_ctr_avg = fixed_declining['ctr'].mean()\n    "all_declining_ctr_ref = df[df['trend_direction'] != 'down']['ctr'].mean()\n    "print(f'Avg CTR of declining pages: {declining_ctr_avg:.4f}')\n    "print(f'Avg CTR of non-declining pages: {all_declining_ctr_ref:.4f}')\n",
    "\n",
    "# Limitation 3: Ignores position — a declining page at position 1 matters\n    "# more than one at position 50\n    "declining_with_pos_data = fixed_declining[fixed_declining['avg_position'] > 0]\n    "print(f'Declining pages with position data: {len(declining_with_pos_data)}')\n    "print(f'Among those, avg position: {declining_with_pos_data[\"avg_position\"].mean():.2f}')\n",
    "\n",
    "# Limitation 4: Ignores content age — fresh vs evergreen have different\n    "# refresh needs\n    "declining_age_stats = fixed_declining['content_age_days'].describe()\n    "print(f'Age stats for declining pages:')\n    "print(declining_age_stats)\n",
    "\n",
    "# ML could potentially improve this by learning relationships across multiple\n",
    "# features (impressions, CTR, position, content age, trend_pct, etc.) and\n",
    "# producing a more differentiated output — pages with high impressions +\n    "# declining trend + good position get highest priority, while pages with\n    "# low impressions + flat trend get lower priority.\n",
    "\n",
    "# CAREFUL WORDING: ML could potentially outperform a fixed rule if the\n",
    "# available features contain predictive signal and the model generalizes to\n",
    "# unseen data. This must be demonstrated through validation — we are not\n",
    "claiming ML is automatically better. The fixed rule is a reasonable\n",
    "starting baseline (it captures 54.2% of pages with declining trends), but\n",
    "it has significant limitations:\n",
    "- It treats all declining pages equally, regardless of impressions, CTR, or position\n",
    "- It cannot differentiate high-impact opportunities from low-impact ones\n",
    "- It ignores features that may contain useful signal for prioritization\n",
    "- It is difficult to tune manually as patterns change over time"
   ]
  },
